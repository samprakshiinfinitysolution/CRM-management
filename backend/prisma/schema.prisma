generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEAM_LEADER
  SALES_EXECUTIVE
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  QUALIFIED
  PROPOSAL_QUOTATION
  NEGOTIATION
  WON_SOLD
  NOT_INTERESTED
  NO_RESPONSE
  WRONG_NUMBER
  INVALID
  DUPLICATE
  ON_HOLD
  LOST
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  DELETED
}

enum FollowUpOutcome {
  CONNECTED
  NO_RESPONSE
  INTERESTED
  NOT_INTERESTED
  QUALIFIED
  PROPOSAL_REQUIRED
  NEGOTIATION
  WON
  WRONG_NUMBER
  RESCHEDULED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(SALES_EXECUTIVE)
  isActive     Boolean       @default(true)
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignedLeads       Lead[]           @relation("LeadAssignedTo")
  delegatedLeads      Lead[]           @relation("LeadAssignedBy")
  leadAssignments     LeadAssignment[] @relation("AssignmentTo")
  delegatedAssignments LeadAssignment[] @relation("AssignmentBy")
  activities          LeadActivity[]
  followUps           LeadFollowUp[]
  statusChanges       LeadStatusHistory[]
  notes               LeadNote[]
  importBatches       ImportBatch[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([email])
  @@index([role])
}

model Lead {
  id              String        @id @default(uuid())
  leadCode        String        @unique // e.g. CRM-000001
  customerName    String
  mobile          String
  alternateMobile String?
  email           String?
  companyName     String?
  city            String?
  state           String?
  requirement     String
  productService  String?
  budget          Decimal?      @db.Decimal(12, 2)
  leadSource      String?
  priority        PriorityLevel @default(MEDIUM)
  status          LeadStatus    @default(NEW)

  assignedToUserId String?
  assignedTo       User?         @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id])
  assignedByUserId String?
  assignedBy       User?         @relation("LeadAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime?

  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  assignments      LeadAssignment[]
  activities       LeadActivity[]
  followUps        LeadFollowUp[]
  statusHistory    LeadStatusHistory[]
  notes            LeadNote[]

  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([assignedToUserId])
  @@index([isDeleted])
}

model LeadAssignment {
  id               String    @id @default(uuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToUserId String
  assignedTo       User      @relation("AssignmentTo", fields: [assignedToUserId], references: [id])
  assignedByUserId String
  assignedBy       User      @relation("AssignmentBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  reason           String?

  @@index([leadId])
  @@index([assignedToUserId])
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  actionType  String   // STATUS_CHANGE, NOTE_ADDED, CALL_LOG, REASSIGNED, etc.
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([actorUserId])
}

model LeadFollowUp {
  id               String         @id @default(uuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToUserId String
  assignedTo       User           @relation(fields: [assignedToUserId], references: [id])
  scheduledAt      DateTime
  type             String         // Call, Meeting, Email, WhatsApp
  status           FollowUpStatus @default(PENDING)
  outcome          FollowUpOutcome?
  notes            String?
  completedAt      DateTime?
  isDeleted        Boolean        @default(false)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())


  @@index([leadId])
  @@index([assignedToUserId])
  @@index([scheduledAt])
  @@index([status])
}

model LeadStatusHistory {
  id              String     @id @default(uuid())
  leadId          String
  lead            Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus       LeadStatus
  newStatus       LeadStatus
  changedByUserId String
  changedBy       User       @relation(fields: [changedByUserId], references: [id])
  notes           String?
  createdAt       DateTime   @default(now())

  @@index([leadId])
}

model LeadNote {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User     @relation(fields: [authorUserId], references: [id])
  content      String
  createdAt    DateTime @default(now())

  @@index([leadId])
}

model ImportBatch {
  id               String        @id @default(uuid())
  fileName         String
  uploadedByUserId String
  uploadedBy       User          @relation(fields: [uploadedByUserId], references: [id])
  totalRows        Int
  importedCount    Int           @default(0)
  duplicateCount   Int           @default(0)
  failedCount      Int           @default(0)
  createdAt        DateTime      @default(now())

  errors           ImportError[]
}

model ImportError {
  id          String      @id @default(uuid())
  batchId     String
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int
  columnName  String?
  errorMessage String
  rawRowData  Json?
  createdAt   DateTime    @default(now())

  @@index([batchId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String   // CREATE, UPDATE, ASSIGN, REASSIGN, RECALL, IMPORT, EXPORT
  entityType  String   // Lead, User, ImportBatch
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
}

model Notification {
  id              String    @id @default(uuid())
  recipientUserId String
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String    // ASSIGNMENT, FOLLOW_UP, SYSTEM
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([recipientUserId])
  @@index([isRead])
}
